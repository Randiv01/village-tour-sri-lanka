rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Temporary development collection
    match /test_users/{document} {
      allow read, write: if true;
    }

    // User profiles
    match /users/{uid} {

      // Allow anyone to read profiles (needed for "Guided by" details)
      allow read: if true;

      // User can create only their own profile
      allow create: if request.auth != null
                    && request.auth.uid == uid;

      // User can update own profile without changing role
      // OR admin can update any profile
      allow update: if request.auth != null
                    && (
                      (
                        request.auth.uid == uid
                        && request.resource.data.role == resource.data.role
                      )
                      ||
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
                    );

      // Currently disabled
      allow delete: if false;
    }

    // Existing destination development rules
    match /destinations/{document} {
      allow read, write: if true;
    }

    // Homestays (Added from console)
    match /homestays/{document} {
      // Anyone can view homestays
      allow read: if true;

      // Host can create their own homestay
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.hostId;

      // Only the owner can update/delete
      allow update, delete: if request.auth != null
                            && request.auth.uid == resource.data.hostId;
    }

    // Homestay Reviews
    match /homestay_reviews/{reviewId} {
      // Anyone can read reviews (shown publicly on cards and detail screens)
      allow read: if true;
      // Only authenticated travelers can create reviews
      allow create: if request.auth != null
                    && request.resource.data.travelerId == request.auth.uid;
      // Only the author can update/delete their own review
      allow update, delete: if request.auth != null
                            && resource.data.travelerId == request.auth.uid;
    }

    // Tour Packages (Restored)
    match /tour_packages/{packageId} {
      allow read: if resource.data.status == 'active' || 
                    (request.auth != null && resource.data.guideId == request.auth.uid);
      
      allow create: if request.auth != null && request.resource.data.guideId == request.auth.uid;
      
      allow update, delete: if request.auth != null && resource.data.guideId == request.auth.uid;
    }

    // Guide Bookings (Restored)
    match /guide_bookings/{bookingId} {
      // Guides can read, update their own bookings
      allow read, update: if request.auth != null && resource.data.guideId == request.auth.uid;
      
      // Travelers can update their own bookings (for payment completion, etc.)
      allow update: if request.auth != null && resource.data.guestId == request.auth.uid;
      
      // Travelers can read their own bookings (and we must allow general reads for availability overlap checks)
      allow read: if request.auth != null;
      
      // Travelers can create bookings
      allow create: if request.auth != null && request.resource.data.guestId == request.auth.uid;
      
      allow delete: if false; // Prefer logical deletion (status='cancelled')
    }

    // Homestay Bookings
    match /homestay_bookings/{bookingId} {
      allow read, update: if request.auth != null && resource.data.hostId == request.auth.uid;
      allow update: if request.auth != null && resource.data.travelerId == request.auth.uid;
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.travelerId == request.auth.uid;
      allow delete: if false;
    }

    // Payments
    match /payments/{paymentId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // We don't allow clients to update arbitrary payment fields.
      // But they need to update status upon mock payment success. 
      // In a real app this would be a cloud function.
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
    }
    
    // Chats
    match /chats/{chatId} {
      allow read, write: if request.auth != null;
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
